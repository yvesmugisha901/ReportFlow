{"type":"app","meta":{"headers":{"x-next-cache-tags":"_N_T_/layout,_N_T_/page,_N_T_/"}},"html":"<!DOCTYPE html><html lang=\"en\"><head><meta charSet=\"utf-8\"/><meta name=\"viewport\" content=\"width=device-width, initial-scale=1\"/><meta name=\"viewport\" content=\"width=device-width, initial-scale=1\"/><link rel=\"stylesheet\" href=\"/_next/static/css/3f00c259d5cfedb5.css\" data-precedence=\"next\"/><link rel=\"preload\" as=\"script\" fetchPriority=\"low\" href=\"/_next/static/chunks/webpack-e50a67b1b444ac59.js\"/><script src=\"/_next/static/chunks/fd9d1056-f09744c5e9674c7b.js\" async=\"\"></script><script src=\"/_next/static/chunks/117-22b5d3efff11d31e.js\" async=\"\"></script><script src=\"/_next/static/chunks/main-app-6fedf897974e7dfc.js\" async=\"\"></script><script src=\"/_next/static/chunks/648-f0e7c48ffc05bd7d.js\" async=\"\"></script><script src=\"/_next/static/chunks/app/page-522d2ad519b6e110.js\" async=\"\"></script><script src=\"/_next/static/chunks/646-ccace709bffb7609.js\" async=\"\"></script><script src=\"/_next/static/chunks/app/layout-e4d30c1910e69bbb.js\" async=\"\"></script><title>ReportFlow</title><meta name=\"description\" content=\"Internal Reporting System\"/><link rel=\"icon\" href=\"/favicon.ico\" type=\"image/x-icon\" sizes=\"16x16\"/><script src=\"/_next/static/chunks/polyfills-42372ed130431b0a.js\" noModule=\"\"></script></head><body><div class=\"min-h-screen bg-[#f8f9fc] text-[#0f1117] overflow-x-hidden\"><div class=\"fixed inset-0 pointer-events-none overflow-hidden z-0\"><div class=\"absolute -top-40 -left-40 w-[600px] h-[600px] rounded-full bg-indigo-100 blur-[120px]\"></div><div class=\"absolute bottom-0 right-0 w-[500px] h-[500px] rounded-full bg-violet-100 blur-[100px]\"></div><div class=\"absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[400px] h-[400px] rounded-full bg-sky-100 blur-[80px]\"></div></div><nav class=\"relative z-20 flex items-center justify-between px-8 py-4 bg-white/80 backdrop-blur-md border-b border-gray-200 sticky top-0\"><div class=\"flex items-center gap-3\"><div class=\"w-8 h-8 rounded-lg bg-gradient-to-br from-indigo-500 to-violet-600 flex items-center justify-center shadow-md shadow-indigo-200\"><svg class=\"w-4 h-4 text-white\" fill=\"none\" viewBox=\"0 0 24 24\" stroke=\"currentColor\" stroke-width=\"2.5\"><path stroke-linecap=\"round\" stroke-linejoin=\"round\" d=\"M9 17v-2m3 2v-4m3 4v-6m2 10H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z\"></path></svg></div><span class=\"font-bold text-lg tracking-tight text-gray-900\">ReportFlow</span></div><div class=\"hidden md:flex items-center gap-8 text-sm text-gray-500\"><a href=\"#features\" class=\"hover:text-gray-900 transition-colors\">Features</a><a href=\"#workflow\" class=\"hover:text-gray-900 transition-colors\">Workflow</a><a href=\"#roles\" class=\"hover:text-gray-900 transition-colors\">Roles</a></div><div class=\"flex items-center gap-3\"><a class=\"text-sm text-gray-600 hover:text-gray-900 px-4 py-2 transition-colors font-medium\" href=\"/auth/login\">Sign in</a><a class=\"text-sm bg-indigo-600 hover:bg-indigo-700 text-white px-4 py-2.5 rounded-xl transition-colors shadow-md shadow-indigo-200 font-medium\" href=\"/auth/register\">Get started</a></div></nav><section class=\"relative z-10 flex flex-col items-center text-center px-6 pt-24 pb-20\"><h1 class=\"text-5xl md:text-[4.5rem] font-extrabold tracking-tight leading-[1.06] max-w-4xl mb-5 text-gray-900\">Reports that flow<br/><span class=\"bg-gradient-to-r from-indigo-600 via-violet-600 to-sky-500 bg-clip-text text-transparent\">through your organization</span></h1><p class=\"text-base md:text-lg text-gray-500 max-w-lg leading-relaxed mb-10\">Structured submission, two-stage approval, and real-time tracking — all in one system built for how your teams actually work.</p><div class=\"flex flex-col sm:flex-row gap-3 mb-20\"><a class=\"px-7 py-3.5 bg-indigo-600 hover:bg-indigo-700 text-white text-sm font-semibold rounded-xl transition-all shadow-lg shadow-indigo-200 hover:-translate-y-0.5\" href=\"/auth/register\">Start using ReportFlow →</a><a class=\"px-7 py-3.5 bg-white hover:bg-gray-50 text-gray-700 text-sm font-medium rounded-xl border border-gray-200 hover:border-gray-300 transition-all shadow-sm\" href=\"/auth/login\">Sign in to your account</a></div><div class=\"relative w-full max-w-4xl mx-auto\"><div class=\"absolute bottom-0 left-0 right-0 h-28 bg-gradient-to-t from-[#f8f9fc] to-transparent z-10 pointer-events-none rounded-b-2xl\"></div><div class=\"bg-white border border-gray-200 rounded-2xl overflow-hidden shadow-2xl shadow-gray-200\"><div class=\"flex items-center gap-2 px-5 py-3.5 border-b border-gray-100 bg-gray-50\"><div class=\"w-3 h-3 rounded-full bg-red-400\"></div><div class=\"w-3 h-3 rounded-full bg-yellow-400\"></div><div class=\"w-3 h-3 rounded-full bg-green-400\"></div><span class=\"ml-4 text-[11px] text-gray-400 tracking-wide\">reportflow.internal / admin / dashboard</span></div><div class=\"flex\"><div class=\"hidden md:flex w-52 flex-col border-r border-gray-100 p-4 gap-1 bg-gray-50/50\"><div class=\"flex items-center gap-3 px-3 py-2.5 rounded-lg text-xs font-medium bg-indigo-600 text-white shadow-sm\"><div class=\"w-1.5 h-1.5 rounded-full bg-indigo-200\"></div>Dashboard</div><div class=\"flex items-center gap-3 px-3 py-2.5 rounded-lg text-xs font-medium text-gray-500\"><div class=\"w-1.5 h-1.5 rounded-full bg-gray-300\"></div>Reports</div><div class=\"flex items-center gap-3 px-3 py-2.5 rounded-lg text-xs font-medium text-gray-500\"><div class=\"w-1.5 h-1.5 rounded-full bg-gray-300\"></div>Departments</div><div class=\"flex items-center gap-3 px-3 py-2.5 rounded-lg text-xs font-medium text-gray-500\"><div class=\"w-1.5 h-1.5 rounded-full bg-gray-300\"></div>Approvals</div><div class=\"flex items-center gap-3 px-3 py-2.5 rounded-lg text-xs font-medium text-gray-500\"><div class=\"w-1.5 h-1.5 rounded-full bg-gray-300\"></div>Users</div><div class=\"flex items-center gap-3 px-3 py-2.5 rounded-lg text-xs font-medium text-gray-500\"><div class=\"w-1.5 h-1.5 rounded-full bg-gray-300\"></div>Settings</div></div><div class=\"flex-1 p-5 bg-white\"><div class=\"grid grid-cols-2 md:grid-cols-4 gap-3 mb-4\"><div class=\"bg-white border border-gray-100 rounded-xl p-4 shadow-sm\"><div class=\"text-lg mb-1\">📋</div><div class=\"text-xl font-bold text-gray-900\">248</div><div class=\"text-[10px] text-gray-400 mt-0.5 font-medium\">Total Reports</div></div><div class=\"bg-white border border-gray-100 rounded-xl p-4 shadow-sm\"><div class=\"text-lg mb-1\">⏳</div><div class=\"text-xl font-bold text-gray-900\">17</div><div class=\"text-[10px] text-gray-400 mt-0.5 font-medium\">Pending Review</div></div><div class=\"bg-white border border-gray-100 rounded-xl p-4 shadow-sm\"><div class=\"text-lg mb-1\">✅</div><div class=\"text-xl font-bold text-gray-900\">198</div><div class=\"text-[10px] text-gray-400 mt-0.5 font-medium\">Approved</div></div><div class=\"bg-white border border-gray-100 rounded-xl p-4 shadow-sm\"><div class=\"text-lg mb-1\">🏢</div><div class=\"text-xl font-bold text-gray-900\">6</div><div class=\"text-[10px] text-gray-400 mt-0.5 font-medium\">Departments</div></div></div><div class=\"bg-white border border-gray-100 rounded-xl overflow-hidden shadow-sm\"><div class=\"px-4 py-3 border-b border-gray-100 flex justify-between items-center bg-gray-50/50\"><span class=\"text-xs font-semibold text-gray-600\">Recent Submissions</span><span class=\"text-[11px] text-indigo-600 font-medium\">View all →</span></div><div class=\"flex items-center justify-between px-4 py-3 border-b border-gray-50 last:border-0\"><div><div class=\"text-xs font-medium text-gray-800\">Monthly Finance Report</div><div class=\"text-[10px] text-gray-400 mt-0.5\">Finance</div></div><span class=\"text-[10px] px-2.5 py-1 rounded-full font-semibold bg-emerald-100 text-emerald-700\">Approved</span></div><div class=\"flex items-center justify-between px-4 py-3 border-b border-gray-50 last:border-0\"><div><div class=\"text-xs font-medium text-gray-800\">Q2 Operations Summary</div><div class=\"text-[10px] text-gray-400 mt-0.5\">Operations</div></div><span class=\"text-[10px] px-2.5 py-1 rounded-full font-semibold bg-amber-100 text-amber-700\">Under Review</span></div><div class=\"flex items-center justify-between px-4 py-3 border-b border-gray-50 last:border-0\"><div><div class=\"text-xs font-medium text-gray-800\">HR Compliance Report</div><div class=\"text-[10px] text-gray-400 mt-0.5\">Human Resources</div></div><span class=\"text-[10px] px-2.5 py-1 rounded-full font-semibold bg-gray-100 text-gray-600\">Pending</span></div></div></div></div></div></div></section><section id=\"features\" class=\"relative z-10 px-8 py-24 max-w-6xl mx-auto\"><div class=\"text-center mb-16\"><h2 class=\"text-3xl font-bold mb-3 text-gray-900\">Everything your org needs</h2><p class=\"text-gray-500 text-sm max-w-md mx-auto\">From first submission to final sign-off — tracked, notified, and archived.</p></div><div class=\"grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4\"><div class=\"bg-white hover:bg-gray-50 border border-gray-200 hover:border-indigo-200 rounded-2xl p-6 transition-all shadow-sm hover:shadow-md\"><div class=\"text-2xl mb-4\">🗓️</div><h3 class=\"font-semibold text-sm text-gray-900 mb-2\">Scheduled Reporting</h3><p class=\"text-xs text-gray-500 leading-relaxed\">Admins define frequencies — monthly, bi-weekly — and timelines auto-generate for each team and department.</p></div><div class=\"bg-white hover:bg-gray-50 border border-gray-200 hover:border-indigo-200 rounded-2xl p-6 transition-all shadow-sm hover:shadow-md\"><div class=\"text-2xl mb-4\">🔁</div><h3 class=\"font-semibold text-sm text-gray-900 mb-2\">Two-Stage Approval</h3><p class=\"text-xs text-gray-500 leading-relaxed\">Department Reviewer then COO/Final Approver. Approve, reject, or request changes at each stage.</p></div><div class=\"bg-white hover:bg-gray-50 border border-gray-200 hover:border-indigo-200 rounded-2xl p-6 transition-all shadow-sm hover:shadow-md\"><div class=\"text-2xl mb-4\">🔔</div><h3 class=\"font-semibold text-sm text-gray-900 mb-2\">Smart Notifications</h3><p class=\"text-xs text-gray-500 leading-relaxed\">In-app and email alerts triggered when reports are requested, submitted, reviewed, or approved.</p></div><div class=\"bg-white hover:bg-gray-50 border border-gray-200 hover:border-indigo-200 rounded-2xl p-6 transition-all shadow-sm hover:shadow-md\"><div class=\"text-2xl mb-4\">📊</div><h3 class=\"font-semibold text-sm text-gray-900 mb-2\">Role Dashboards</h3><p class=\"text-xs text-gray-500 leading-relaxed\">Tailored views for Admin, Employee, Reviewer, and Approver. Each role sees exactly what they need.</p></div><div class=\"bg-white hover:bg-gray-50 border border-gray-200 hover:border-indigo-200 rounded-2xl p-6 transition-all shadow-sm hover:shadow-md\"><div class=\"text-2xl mb-4\">🔍</div><h3 class=\"font-semibold text-sm text-gray-900 mb-2\">Search &amp; Filtering</h3><p class=\"text-xs text-gray-500 leading-relaxed\">Filter reports by department, team, date, report type, and status in seconds.</p></div><div class=\"bg-white hover:bg-gray-50 border border-gray-200 hover:border-indigo-200 rounded-2xl p-6 transition-all shadow-sm hover:shadow-md\"><div class=\"text-2xl mb-4\">🏢</div><h3 class=\"font-semibold text-sm text-gray-900 mb-2\">Org Management</h3><p class=\"text-xs text-gray-500 leading-relaxed\">Create departments, build teams inside them, register employees and manage their assignments.</p></div></div></section><section id=\"workflow\" class=\"relative z-10 px-8 py-20 border-t border-gray-100\"><div class=\"max-w-4xl mx-auto text-center\"><h2 class=\"text-3xl font-bold mb-3 text-gray-900\">The approval journey</h2><p class=\"text-gray-500 text-sm mb-14\">Every report travels a clear, auditable path from submission to archive.</p><div class=\"flex flex-col md:flex-row items-center justify-center gap-2 md:gap-0\"><div class=\"flex items-center\"><div class=\"flex flex-col items-center text-center w-44 px-2\"><div class=\"w-12 h-12 rounded-2xl flex items-center justify-center text-sm font-bold mb-3 border-2 shadow-sm bg-indigo-50 text-indigo-600 border-indigo-200\">01</div><div class=\"font-semibold text-sm text-gray-900 mb-1\">Submit</div><div class=\"text-xs text-gray-500 leading-relaxed\">Employee uploads or fills the report form on schedule</div></div><div class=\"hidden md:block w-8 h-px bg-gray-200 flex-shrink-0\"></div></div><div class=\"flex items-center\"><div class=\"flex flex-col items-center text-center w-44 px-2\"><div class=\"w-12 h-12 rounded-2xl flex items-center justify-center text-sm font-bold mb-3 border-2 shadow-sm bg-violet-50 text-violet-600 border-violet-200\">02</div><div class=\"font-semibold text-sm text-gray-900 mb-1\">Dept. Review</div><div class=\"text-xs text-gray-500 leading-relaxed\">Department Reviewer approves or requests changes</div></div><div class=\"hidden md:block w-8 h-px bg-gray-200 flex-shrink-0\"></div></div><div class=\"flex items-center\"><div class=\"flex flex-col items-center text-center w-44 px-2\"><div class=\"w-12 h-12 rounded-2xl flex items-center justify-center text-sm font-bold mb-3 border-2 shadow-sm bg-sky-50 text-sky-600 border-sky-200\">03</div><div class=\"font-semibold text-sm text-gray-900 mb-1\">Final Approval</div><div class=\"text-xs text-gray-500 leading-relaxed\">COO or Final Approver gives the last sign-off</div></div><div class=\"hidden md:block w-8 h-px bg-gray-200 flex-shrink-0\"></div></div><div class=\"flex items-center\"><div class=\"flex flex-col items-center text-center w-44 px-2\"><div class=\"w-12 h-12 rounded-2xl flex items-center justify-center text-sm font-bold mb-3 border-2 shadow-sm bg-emerald-50 text-emerald-600 border-emerald-200\">04</div><div class=\"font-semibold text-sm text-gray-900 mb-1\">Archived</div><div class=\"text-xs text-gray-500 leading-relaxed\">Stored with full status history and timestamps</div></div></div></div></div></section><section id=\"roles\" class=\"relative z-10 px-8 py-20 border-t border-gray-100\"><div class=\"max-w-4xl mx-auto text-center mb-12\"><h2 class=\"text-3xl font-bold mb-3 text-gray-900\">Built for every role</h2><p class=\"text-gray-500 text-sm\">Each role has its own dashboard and permissions.</p></div><div class=\"grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-4 max-w-5xl mx-auto\"><div class=\"bg-white border border-indigo-200 rounded-2xl p-5 shadow-sm hover:shadow-md transition-all\"><div class=\"w-10 h-10 rounded-xl bg-indigo-50 flex items-center justify-center text-xl mb-3\">⚙️</div><div class=\"text-sm font-bold mb-3 text-indigo-700\">Admin</div><ul class=\"space-y-1.5\"><li class=\"text-[11px] text-gray-500 flex items-start gap-2\"><span class=\"mt-0.5 font-bold text-indigo-500\">✓</span>Create departments &amp; teams</li><li class=\"text-[11px] text-gray-500 flex items-start gap-2\"><span class=\"mt-0.5 font-bold text-indigo-500\">✓</span>Register employees</li><li class=\"text-[11px] text-gray-500 flex items-start gap-2\"><span class=\"mt-0.5 font-bold text-indigo-500\">✓</span>Define report schedules</li><li class=\"text-[11px] text-gray-500 flex items-start gap-2\"><span class=\"mt-0.5 font-bold text-indigo-500\">✓</span>Full system access</li></ul></div><div class=\"bg-white border border-sky-200 rounded-2xl p-5 shadow-sm hover:shadow-md transition-all\"><div class=\"w-10 h-10 rounded-xl bg-sky-50 flex items-center justify-center text-xl mb-3\">👤</div><div class=\"text-sm font-bold mb-3 text-sky-700\">Employee</div><ul class=\"space-y-1.5\"><li class=\"text-[11px] text-gray-500 flex items-start gap-2\"><span class=\"mt-0.5 font-bold text-sky-500\">✓</span>Submit scheduled reports</li><li class=\"text-[11px] text-gray-500 flex items-start gap-2\"><span class=\"mt-0.5 font-bold text-sky-500\">✓</span>Upload files or forms</li><li class=\"text-[11px] text-gray-500 flex items-start gap-2\"><span class=\"mt-0.5 font-bold text-sky-500\">✓</span>Track submission status</li><li class=\"text-[11px] text-gray-500 flex items-start gap-2\"><span class=\"mt-0.5 font-bold text-sky-500\">✓</span>Receive notifications</li></ul></div><div class=\"bg-white border border-violet-200 rounded-2xl p-5 shadow-sm hover:shadow-md transition-all\"><div class=\"w-10 h-10 rounded-xl bg-violet-50 flex items-center justify-center text-xl mb-3\">🔍</div><div class=\"text-sm font-bold mb-3 text-violet-700\">Dept. Reviewer</div><ul class=\"space-y-1.5\"><li class=\"text-[11px] text-gray-500 flex items-start gap-2\"><span class=\"mt-0.5 font-bold text-violet-500\">✓</span>Review dept. submissions</li><li class=\"text-[11px] text-gray-500 flex items-start gap-2\"><span class=\"mt-0.5 font-bold text-violet-500\">✓</span>Approve / reject / revise</li><li class=\"text-[11px] text-gray-500 flex items-start gap-2\"><span class=\"mt-0.5 font-bold text-violet-500\">✓</span>See dept. progress</li><li class=\"text-[11px] text-gray-500 flex items-start gap-2\"><span class=\"mt-0.5 font-bold text-violet-500\">✓</span>Stage-1 sign-off</li></ul></div><div class=\"bg-white border border-emerald-200 rounded-2xl p-5 shadow-sm hover:shadow-md transition-all\"><div class=\"w-10 h-10 rounded-xl bg-emerald-50 flex items-center justify-center text-xl mb-3\">✅</div><div class=\"text-sm font-bold mb-3 text-emerald-700\">Final Approver</div><ul class=\"space-y-1.5\"><li class=\"text-[11px] text-gray-500 flex items-start gap-2\"><span class=\"mt-0.5 font-bold text-emerald-500\">✓</span>Final approval authority</li><li class=\"text-[11px] text-gray-500 flex items-start gap-2\"><span class=\"mt-0.5 font-bold text-emerald-500\">✓</span>Cross-dept. visibility</li><li class=\"text-[11px] text-gray-500 flex items-start gap-2\"><span class=\"mt-0.5 font-bold text-emerald-500\">✓</span>Compliance tracking</li><li class=\"text-[11px] text-gray-500 flex items-start gap-2\"><span class=\"mt-0